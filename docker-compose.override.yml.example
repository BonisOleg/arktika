services:
  # ЛОКАЛЬНО: cp docker-compose.override.yml.example docker-compose.override.yml
  # На Droplet цей файл НЕ має існувати як override.yml — інакше runserver+develop.
  backend:
    command: python manage.py runserver 0.0.0.0:8000
    env_file:
      - .env
    ports:
      - "8000:8000"
    environment:
      DJANGO_SETTINGS_MODULE: config.settings.develop

  db:
    env_file:
      - .env
    ports:
      - "5432:5432"
