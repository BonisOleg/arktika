# Production Docker — HTTP-first на Droplet 157.230.99.135
# На сервері: bash deploy/docker/gen-env.sh   (або cp .env.docker.example .env)
# НЕ комітити .env.
#
# Канон: django-droplet-http-first → пізніше SSL (django-docker-ssl).

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-me-with-python-secrets-token-urlsafe-50
DEBUG=False

# HTTP по IP: False. Після DNS+certbot → True + CSRF https://…
USE_HTTPS=False

POSTGRES_DB=arctica
POSTGRES_USER=arctica
POSTGRES_PASSWORD=replace-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Реальний IPv4 + localhost/backend для healthcheck (не лишати DROPLET_IP)
ALLOWED_HOSTS=157.230.99.135,127.0.0.1,localhost,backend
CSRF_TRUSTED_ORIGINS=http://157.230.99.135

ADMIN_URL=admin/

SITE_DOMAIN=157.230.99.135
SITE_PROTOCOL=http

# Nova Poshta (без ключа — fixtures / вільний текст)
NP_API_KEY=
NP_SENDER_REF=
NP_SENDER_CITY_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_PHONE=
NP_REQUIRE_REF_SELECTION=False

# WayForPay — sandbox wiki доки немає домену/ключів клієнта
WAYFORPAY_MERCHANT_LOGIN=test_merch_n1
WAYFORPAY_MERCHANT_SECRET_KEY=flk3409refn54t54t*FNJRET
WAYFORPAY_DOMAIN=www.market.ua

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

RECAPTCHA_PUBLIC_KEY=
