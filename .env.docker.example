# Production Docker — HTTP-first.
# На сервері:
#   DROPLET_IP=x.x.x.x SITE_DOMAIN=example.com bash deploy/docker/gen-env.sh
# НЕ комітити .env.
#
# Канон: django-droplet-http-first → пізніше SSL (django-docker-ssl).

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-me-with-python-secrets-token-urlsafe-50
DEBUG=False

# HTTP: False. Після certbot + deploy.sh (є /etc/letsencrypt/live/SITE_DOMAIN):
#   USE_HTTPS=True
#   SITE_PROTOCOL=https
#   CSRF_TRUSTED_ORIGINS=https://SITE_DOMAIN,https://www.SITE_DOMAIN,http://DROPLET_IP
USE_HTTPS=False

POSTGRES_DB=arctica
POSTGRES_USER=arctica
POSTGRES_PASSWORD=replace-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Заповнює gen-env.sh (DROPLET_IP + SITE_DOMAIN)
DROPLET_IP=__DROPLET_IP__
ALLOWED_HOSTS=__DROPLET_IP__,127.0.0.1,localhost,backend
CSRF_TRUSTED_ORIGINS=http://__DROPLET_IP__

ADMIN_URL=admin/

SITE_DOMAIN=__SITE_DOMAIN__
SITE_PROTOCOL=http

# Nova Poshta (без ключа — fixtures / вільний текст)
NP_API_KEY=
NP_SENDER_REF=
NP_SENDER_CITY_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_PHONE=
NP_REQUIRE_REF_SELECTION=False

# WayForPay — sandbox wiki доки немає домену/ключів клієнта
WAYFORPAY_MERCHANT_LOGIN=test_merch_n1
WAYFORPAY_MERCHANT_SECRET_KEY=flk3409refn54t54t*FNJRET
WAYFORPAY_DOMAIN=www.market.ua

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
