# HTTPS (django-docker-ssl): False до certbot. True після — Secure-cookies + HSTS.
# Редірект http→https робить nginx, не Django (SECURE_SSL_REDIRECT завжди False).
# Тестовий Droplet HTTP+IP: False + SITE_PROTOCOL=http (див. .env.docker.example)
USE_HTTPS=False

